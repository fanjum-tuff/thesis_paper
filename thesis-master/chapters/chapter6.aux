\newlabel{eq:dbexp}{{6.3}{75}{Cracking capacity grows almost in proportion to bar diameter}{equation.6.3}{}}
\@writefile{toc}{\contentsline {paragraph}{The failure mode shifts with bar size.}{75}{section*.81}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Stiffness grows faster than strength.}{75}{section*.82}\protected@file@percent }
\newlabel{fig:factordb-load}{{6.2.2.1a}{75}{\relax }{figure.caption.83}{}}
