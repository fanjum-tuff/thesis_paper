\@writefile{toc}{\contentsline {paragraph}{The mean bond stress falls, but the bond does not weaken.}{73}{section*.74}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{The stiffness levels off at the same embedment.}{73}{section*.75}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{The slip at failure is constant.}{73}{section*.76}\protected@file@percent }
\newlabel{fig:factorL-load}{{6.2.1.1a}{74}{\relax }{figure.caption.77}{}}
\newlabel{sub@fig:factorL-load}{{a}{74}{\relax }{figure.caption.77}{}}
