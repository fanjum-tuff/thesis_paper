\@writefile{lof}{\contentsline {figure}{\numberline {6.2.2.1}{\ignorespaces Effect of bar diameter at fixed embedment ($L = \SI {150}{\milli \metre }$, $f'_c = \SI {32}{\mega \pascal }$, $r_e = \SI {75}{\milli \metre }$). (a)~The cracking load rises almost in proportion to the diameter, following $d_b^{0.89}$. (b)~The mean bond stress is nearly constant, falling only \SI {12}{\percent } over a threefold increase in bar size, which is the same result seen another way.}}{75}{figure.caption.83}\protected@file@percent }
\newlabel{fig:factordb}{{6.2.2.1}{75}{Effect of bar diameter at fixed embedment ($L = \SI {150}{\milli \metre }$, $f'_c = \SI {32}{\mega \pascal }$, $r_e = \SI {75}{\milli \metre }$). (a)~The cracking load rises almost in proportion to the diameter, following $d_b^{0.89}$. (b)~The mean bond stress is nearly constant, falling only \SI {12}{\percent } over a threefold increase in bar size, which is the same result seen another way}{figure.caption.83}{}}
