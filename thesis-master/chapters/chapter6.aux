\newlabel{sec:paramconc}{{6.5}{84}{Conclusions}{section.6.5}{}}
\@writefile{toc}{\contentsline {paragraph}{Cracking capacity scales almost in proportion to bar diameter.}{84}{section*.99}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Cracking capacity and stiffness both level off within about ten diameters.}{84}{section*.100}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{The concrete-strength exponent decomposes exactly.}{84}{section*.101}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{The predicted failure mode shifts with geometry.}{84}{section*.102}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{The model is robust to its invented parameters but not to one assumption.}{85}{section*.103}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Cover is understated by construction.}{85}{section*.104}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{What follows.}{85}{section*.105}\protected@file@percent }
