\newlabel{eq:as3600ld}{{7.9}{92}{The size of the discrepancy}{equation.7.9}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {7.5.3}Calibration cannot close the gap}{92}{subsection.7.5.3}\protected@file@percent }
\newlabel{eq:lcharneeded}{{7.10}{92}{Calibration cannot close the gap}{equation.7.10}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {7.5.4}Why the gap exists}{92}{subsection.7.5.4}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Real anchorages do not saturate, because they are not elastic.}{92}{section*.113}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{What is predicted is first cracking, not ultimate capacity.}{92}{section*.114}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{The specimen is unconfined.}{93}{section*.115}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {7.5.5}What the equation is therefore good for}{93}{subsection.7.5.5}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {7.6}Comparison with code and research expressions}{93}{section.7.6}\protected@file@percent }
\newlabel{sec:codecompare}{{7.6}{93}{Comparison with code and research expressions}{section.7.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {7.6.0.1}{\ignorespaces Structure of the present expression against three code and research formulations.}}{93}{table.caption.116}\protected@file@percent }
\newlabel{tab:codecompare}{{7.6.0.1}{93}{Structure of the present expression against three code and research formulations}{table.caption.116}{}}
\@writefile{toc}{\contentsline {section}{\numberline {7.7}Conclusions}{94}{section.7.7}\protected@file@percent }
\newlabel{sec:devconc}{{7.7}{94}{Conclusions}{section.7.7}{}}
\@writefile{toc}{\contentsline {paragraph}{The capacity--embedment relationship has a shear-lag form.}{94}{section*.117}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Slenderness is not a similarity variable.}{94}{section*.118}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{A grade-independent development length expression follows by inversion.}{94}{section*.119}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{The expression is bounded by the saturation capacity, and the bound binds.}{94}{section*.120}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{The model should therefore be presented as a cracking model.}{94}{section*.121}\protected@file@percent }
