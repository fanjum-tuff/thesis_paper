\@writefile{lot}{\contentsline {table}{\numberline {7.5.1.1}{\ignorespaces Saturated capacity against the force required to yield the bar ($f_{sy} = \SI {550}{\mega \pascal }$, $f'_c = \SI {32}{\mega \pascal }$, $d_{cyl} = \SI {150}{\milli \metre }$, $l_{char} = \SI {20}{\milli \metre }$).}}{91}{table.caption.112}\protected@file@percent }
