  issn = {0899-1561, 1943-5533},
  doi = {10.1061/(ASCE)0899-1561(2004)16:4(365)},
  urldate = {2026-02-27},
  abstract = {A comparative analytical study of the average bond strength at failure of reinforcing bars embedded in unconfined normalstrength concrete \textasciitilde NSC! and high-strength concrete \textasciitilde HSC! is undertaken. The analysis makes use of an experimentally derived local bond stress-slip model and considers the progressive bond deterioration along the development/splice length with the increase in bar force. Results of the average bond strength \textasciitilde or development/splice strength! predicted by the analysis showed excellent agreement with experimental data for both NSC and HSC. The analysis predicted a highly nonuniform bond stress distribution at bond failure along the development/splice length, particularly for HSC. Below a certain limit of the development/splice length \textasciitilde about 15-- 20db), the average bond strength at failure, normalized to f c81/2 , is larger for HSC as compared to NSC. However, as the development length increases beyond this limit, the normalized bond strength of HSC becomes progressively smaller than that of NSC. While normalization of the average bond strength to f c81/4 may underestimate the effect of f c8 on the bond strength for short development/splice lengths, it leads to almost identical normalized bond strength results for NSC and HSC within the practical range of development/splice lengths \textasciitilde in excess of 17-- 20db).},
  langid = {english},
  file = {C:\Users\Farhan\Zotero\storage\WDQ7ZMSR\Harajli - 2004 - Comparison of Bond Strength of Steel Bars in Normal- and High-Strength Concrete.pdf}
