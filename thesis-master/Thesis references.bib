  author = {Mazumder, Maruful Hasan and Gilbert, Raymond Ian and Chang, Zhen-Tian},
  year = 2012,
  volume = {1},
  abstract = {The attainment of satisfactory performance in bond is the most important aim of detailing the reinforcement in reinforced concrete elements, particularly for reinforcing bars in tension. However, the anchorage of reinforcement has been addressed in the major concrete standards through empirical formulations mainly based on the results of experimental tests involving monotonically increasing static loads. Because the emphasis had been on the specification of a development length, a quantitative assessment of bond behaviour is missing in the different analytical formulations for bond stresses and development length. Likewise, widely used bond models for numerical finite element simulation of reinforced concrete structures also have limitations as the user's choice of a particular bond-slip constitutive law is subjective depending the qualitative behavior and properties of the materials. This paper includes an evaluation of test data measured in a recent experimental research program in the Centre for Infrastructure Engineering and Safety (CIES) at the University of New South Wales, Sydney, Australia. A reassessment is made of several of the factors that have been identified in previous studies as having a major influence on the bond strength, and the requirements for anchorage length for different loading conditions and structural geometries are re-examined. Based on the outcome of the experimental research, a critical review is made of several well known analytical models for bond stress and development length and the importance of using improved formulation for such purposes is stressed. In addition, inconsistencies between experimental results and the code specifications regarding development length are exposed.},
  langid = {english},
  file = {C:\Users\Farhan\Zotero\storage\HQRMUH7W\Mazumder et al. - 2012 - Bond and Anchorage Length of Deformed Reinforcing Bars in Tension The Way Forward for Advanced Form.pdf}
}

