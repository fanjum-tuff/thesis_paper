@article{fosterDevelopmentLapLengths,
  title = {Development and {{Lap Lengths}} for 600 {{MPa Reinforcing Steels}} with an {{Improved Rib Pattern}}},
  author = {Foster, Stephen and Ng, Anthony and McGregor, Graeme and Goudarzi, Hamid Vali Pour},
  abstract = {This study experimentally validates the bond performance and anchorage characteristics of InfraBuild's 600 MPa Class N reinforcing bars with an optimised rib pattern. Fifty-four pull-out tests were conducted on bars from 10 mm to 37 mm in diameter in two stages, with Stage I reported previously and Stage II presented here. The findings show that an anchorage length of 16.2db is sufficient to develop nominal yield strength, while 23db consistently causes bar fracture, ensuring the full tensile capacity is achieved. A plasticity-based model developed to predict anchorage strength was validated using data from both stages and exhibited good correlation with the experimental results. Splitting failure was also examined, with the smaller diameter of the 600 MPa bars offsetting the higher stress under splitting conditions. For both bond and splitting failure, a factor of safety of 1.4 relative to the {$\phi$}-reduced stress corresponds to a strength-reduction factor ({$\phi$}) of 0.6. Comparison with AS 3600:2018 confirms that equivalent capacity Grade 600 bars can replace Grade 500 bars without increasing absolute anchorage length while maintaining similar safety margins.},
  langid = {english},
  file = {C:\Users\Farhan\Zotero\storage\3DP5NHQZ\Foster et al. - Development and Lap Lengths for 600 MPa Reinforcing Steels with an Improved Rib Pattern.pdf}
}

