\contentsline {figure}{\numberline {6.2.1.1}{\ignorespaces Effect of embedment length on the baseline specimen ($d_b = \SI {12}{\milli \metre }$, $f'_c = \SI {32}{\mega \pascal }$, $r_e = \SI {75}{\milli \metre }$). (a)~The predicted cracking load levels off by about \SI {100}{\milli \metre }, gaining only \SI {1.1}{\percent } over the remaining \SI {200}{\milli \metre }. (b)~The mean bond stress continues to fall as $1/L$, because a load that has stopped growing is being divided by a length that has not.}}{74}{figure.caption.77}%
\contentsline {figure}{\numberline {6.2.2.1}{\ignorespaces Effect of bar diameter at fixed embedment ($L = \SI {150}{\milli \metre }$, $f'_c = \SI {32}{\mega \pascal }$, $r_e = \SI {75}{\milli \metre }$). (a)~The cracking load rises almost in proportion to the diameter, following $d_b^{0.89}$. (b)~The mean bond stress is nearly constant, falling only \SI {12}{\percent } over a threefold increase in bar size, which is the same result seen another way.}}{75}{figure.caption.83}%
\contentsline {figure}{\numberline {6.2.3.1}{\ignorespaces Effect of concrete cover ($d_b = \SI {12}{\milli \metre }$, $L = \SI {150}{\milli \metre }$, $f'_c = \SI {32}{\mega \pascal }$) on (a)~the cracking load and (b)~the mean bond stress. The two open markers are the cases in which the averaging disc does not fit inside the concrete and is cut short at the outer face; they are excluded from the fit of \eqref {eq:coverfit}. The remaining six points rise steadily.}}{77}{figure.caption.88}%
\contentsline {figure}{\numberline {6.3.1.1}{\ignorespaces Effect of concrete strength, with $E_c$ following \blx@tocontentsinit {0}\textcite {as3600ConcreteStructures2018} Table 3.1.2 ($d_b = \SI {12}{\milli \metre }$, $L = \SI {150}{\milli \metre }$, $r_e = \SI {75}{\milli \metre }$). (a)~The predicted cracking load and (b)~the mean bond stress, both rising as $(f'_c)^{0.390}$ and flattening gently as the strength increases. Because $d_b$ and $L$ are fixed throughout this sweep the two differ only by the constant bonded area.}}{79}{figure.caption.91}%
\contentsline {figure}{\numberline {6.3.2.1}{\ignorespaces Effect of concrete modulus at constant strength ($f'_c = \SI {32}{\mega \pascal }$, $d_b = \SI {12}{\milli \metre }$, $L = \SI {150}{\milli \metre }$, $r_e = \SI {75}{\milli \metre }$): (a)~cracking load, (b)~mean bond stress. Both \emph {fall} as the concrete stiffens, because $f_t$ and $f_v$ are held constant and only the stress distribution changes.}}{80}{figure.caption.93}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {7.1.1.1}{\ignorespaces Calibration curves: predicted cracking load against normalised embedment length for four bar diameters ($f'_c = \SI {32}{\mega \pascal }$, $d_{cyl} = \SI {150}{\milli \metre }$, $l_{char} = \SI {20}{\milli \metre }$, pull--push).}}{86}{figure.caption.106}%
\contentsline {figure}{\numberline {7.2.3.1}{\ignorespaces The calibration curves of Figure~\ref {fig:calcurves} replotted as $F_u/F_\infty $ against $L/L_0$. The four families collapse onto $\tanh (L/L_0)$, reducing the spread from \SI {88}{} to \SI {12}{\percent }.}}{88}{figure.caption.109}%
