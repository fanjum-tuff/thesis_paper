\contentsline {section}{\numberline {7.5}The limit imposed by the saturation capacity}{91}{section.7.5}%
\contentsline {subsection}{\numberline {7.5.1}The condition}{91}{subsection.7.5.1}%
\contentsline {subsection}{\numberline {7.5.2}The size of the discrepancy}{91}{subsection.7.5.2}%
\contentsline {subsection}{\numberline {7.5.3}Calibration cannot close the gap}{92}{subsection.7.5.3}%
\contentsline {subsection}{\numberline {7.5.4}Why the gap exists}{92}{subsection.7.5.4}%
\contentsline {paragraph}{Real anchorages do not saturate, because they are not elastic.}{92}{section*.113}%
\contentsline {paragraph}{What is predicted is first cracking, not ultimate capacity.}{92}{section*.114}%
\contentsline {paragraph}{The specimen is unconfined.}{93}{section*.115}%
\contentsline {subsection}{\numberline {7.5.5}What the equation is therefore good for}{93}{subsection.7.5.5}%
\contentsline {section}{\numberline {7.6}Comparison with code and research expressions}{93}{section.7.6}%
\contentsline {section}{\numberline {7.7}Conclusions}{94}{section.7.7}%
\contentsline {paragraph}{The capacity--embedment relationship has a shear-lag form.}{94}{section*.117}%
\contentsline {paragraph}{Slenderness is not a similarity variable.}{94}{section*.118}%
\contentsline {paragraph}{A grade-independent development length expression follows by inversion.}{94}{section*.119}%
\contentsline {paragraph}{The expression is bounded by the saturation capacity, and the bound binds.}{94}{section*.120}%
\contentsline {paragraph}{The model should therefore be presented as a cracking model.}{94}{section*.121}%
