\contentsline {section}{\numberline {6.2}Geometric factors}{73}{section.6.2}%
\contentsline {subsection}{\numberline {6.2.1}Embedment length}{73}{subsection.6.2.1}%
\contentsline {paragraph}{The mean bond stress falls, but the bond does not weaken.}{73}{section*.74}%
\contentsline {paragraph}{The stiffness levels off at the same embedment.}{73}{section*.75}%
\contentsline {paragraph}{The slip at failure is constant.}{73}{section*.76}%
\contentsline {subsection}{\numberline {6.2.2}Bar diameter}{74}{subsection.6.2.2}%
\contentsline {paragraph}{Cracking capacity grows almost in proportion to bar diameter.}{75}{section*.80}%
\contentsline {paragraph}{The failure mode shifts with bar size.}{75}{section*.81}%
\contentsline {paragraph}{Stiffness grows faster than strength.}{75}{section*.82}%
\contentsline {subsection}{\numberline {6.2.3}Cover ratio}{76}{subsection.6.2.3}%
\contentsline {paragraph}{Two points must be set aside.}{76}{section*.85}%
\contentsline {paragraph}{The cover effect is weaker than measurements show.}{77}{section*.86}%
\contentsline {paragraph}{Cover buys strength but costs stiffness.}{77}{section*.87}%
\contentsline {subsection}{\numberline {6.2.4}Rib layer thickness}{77}{subsection.6.2.4}%
\contentsline {section}{\numberline {6.3}Material factors}{78}{section.6.3}%
\contentsline {subsection}{\numberline {6.3.1}Concrete strength}{78}{subsection.6.3.1}%
\contentsline {subsection}{\numberline {6.3.2}Concrete stiffness}{80}{subsection.6.3.2}%
\contentsline {subsection}{\numberline {6.3.3}Tensile-to-shear strength ratio}{81}{subsection.6.3.3}%
\contentsline {subsection}{\numberline {6.3.4}Factors of minor influence}{81}{subsection.6.3.4}%
\contentsline {paragraph}{A moderate exponent need not mean a moderate effect.}{82}{section*.96}%
\contentsline {paragraph}{Poisson's ratio and the rib modulus are negligible.}{82}{section*.97}%
\contentsline {section}{\numberline {6.4}Synthesis}{83}{section.6.4}%
\contentsline {subsection}{\numberline {6.4.1}Ranking the factors}{83}{subsection.6.4.1}%
\contentsline {subsection}{\numberline {6.4.2}Capacity and stiffness are not governed alike}{83}{subsection.6.4.2}%
\contentsline {subsection}{\numberline {6.4.3}Where the uncertainty sits}{84}{subsection.6.4.3}%
\contentsline {section}{\numberline {6.5}Conclusions}{84}{section.6.5}%
\contentsline {paragraph}{Cracking capacity scales almost in proportion to bar diameter.}{84}{section*.99}%
\contentsline {paragraph}{Cracking capacity and stiffness both level off within about ten diameters.}{84}{section*.100}%
\contentsline {paragraph}{The concrete-strength exponent decomposes exactly.}{84}{section*.101}%
\contentsline {paragraph}{The predicted failure mode shifts with geometry.}{84}{section*.102}%
\contentsline {paragraph}{The model is robust to its invented parameters but not to one assumption.}{85}{section*.103}%
\contentsline {paragraph}{Cover is understated by construction.}{85}{section*.104}%
\contentsline {paragraph}{What follows.}{85}{section*.105}%
